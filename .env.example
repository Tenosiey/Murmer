# Murmer server settings. Copy to .env: `docker compose up` (repository root)
# and `cargo run` (murmer_server/) both read it. Every line is optional; the
# full list, with defaults, is the Configuration table in README.md.

# --- Access ----------------------------------------------------------------
# Password every client must give to connect. The server refuses to start
# while it, or ADMIN_TOKEN, still begins with "change-me".
SERVER_PASSWORD=change-me
# Unlocks POST /role and bot management. Generate: openssl rand -hex 32
#ADMIN_TOKEN=change-me

# --- Deployment ------------------------------------------------------------
#BIND_ADDRESS=0.0.0.0:3001
# Required behind a reverse proxy, or all users share one rate limit.
#TRUSTED_PROXIES=172.16.0.0/12
# Serve the web client at /. Under Docker it is in the image at /app/web;
# for `cargo run`, build it first (bun run build in murmer_client/).
#WEB_CLIENT_DIR=/app/web
#WEB_CLIENT_DIR=../murmer_client/build
# Where `cargo run` keeps its data. docker-compose.yml sets its own.
#DATABASE_PATH=murmer.db
#UPLOAD_DIR=uploads
#RUST_LOG=murmer_server=info

# --- Voice -----------------------------------------------------------------
# Route large voice channels through the server; also publish the UDP port in
# docker-compose.yml.
#SFU_PUBLIC_IP=203.0.113.10
#SFU_UDP_PORT=3479
#SFU_THRESHOLD=7
#SFU_RETURN_THRESHOLD=4
#MAX_VOICE_CHANNEL_USERS=10
#STUN_SERVERS=stun:stun.l.google.com:19302

# --- Limits ----------------------------------------------------------------
#MAX_MESSAGES_PER_MINUTE=30
#MAX_AUTH_ATTEMPTS_PER_MINUTE=5
#MAX_UPLOADS_PER_MINUTE=20
#MAX_PREVIEWS_PER_MINUTE=30
#MAX_FRAMES_PER_SECOND=20
#UPLOAD_QUOTA_USER_MB=1024
#UPLOAD_QUOTA_TOTAL_MB=20480
#MESSAGE_RETENTION_DAYS=
